rules_version = '2';
// Tabla Eco: Firestore security rules. Deployed with the server code by .github/workflows/functions.yml
// (don't edit them in the Firebase console: the next deploy overwrites that).
// Checked on the Firestore emulator by rules-test/ (npm test --prefix rules-test) before every deploy.
// Devices sign in anonymously (the owner chose no device password). Anyone who copies the app's public
// Firebase config can sign in the same way, so these rules are not a lock; they:
//  - need a sign-in for everything,
//  - allow only the collections the app uses, with basic checks on the important fields,
//  - cap document sizes so nobody can fill the free quota with junk.
// The server (Cloud Functions, admin access) skips these rules, e.g. when it writes remindedFor on an order.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function small() { return request.resource.data.size() <= 100; }

    match /screens/{id}     { allow read: if signedIn(); allow create, update: if signedIn() && small(); allow delete: if signedIn(); }
    // A menu loop step. Checked on the whole saved document (partial updates are merged first).
    function validSlot(d) {
      return d.order is number
        && d.seconds is number && d.seconds > 0 && d.seconds <= 86400
        && d.transition in ['fade', 'slide', 'none']
        && d.pictures is map
        && (!('endsAt' in d) || d.endsAt == null || d.endsAt is number)
        && (!('kind' in d) || d.kind in ['menu', 'special', 'catering']);
    }
    match /slots/{id}       { allow read: if signedIn(); allow create, update: if signedIn() && small() && validSlot(request.resource.data); allow delete: if signedIn(); }
    match /pictures/{id}    { allow read: if signedIn(); allow create, update: if signedIn() && small(); allow delete: if signedIn(); }
    // A catering order. New orders must have the main fields; any save keeps their types right.
    function orderTypes(d) {
      return (!('customerName' in d) || (d.customerName is string && d.customerName.size() <= 200))
        && (!('dueAt' in d) || d.dueAt is number)
        && (!('status' in d) || d.status in ['open', 'completed', 'cancelled'])
        && (!('items' in d) || (d.items is string && d.items.size() <= 20000))
        && (!('type' in d) || d.type in ['pickup', 'delivery'])
        && (!('completedAt' in d) || d.completedAt == null || d.completedAt is number)
        && (!('cancelledAt' in d) || d.cancelledAt == null || d.cancelledAt is number)
        && (!('deletedAt' in d) || d.deletedAt == null || d.deletedAt is number)
        && (!('kitchenAckFor' in d) || d.kitchenAckFor == null || d.kitchenAckFor is number)
        && (!('history' in d) || (d.history is list && d.history.size() <= 50))
        && (!('lines' in d) || (d.lines is list && d.lines.size() <= 300));
    }
    function orderHasMain(d) { return d.keys().hasAll(['customerName', 'dueAt', 'status', 'items']); }
    match /orders/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && small() && orderHasMain(request.resource.data) && orderTypes(request.resource.data);
      allow update: if signedIn() && small() && orderTypes(request.resource.data);
      // No deleting from the app: "Delete" sets deletedAt (hidden everywhere, still in the records).
      allow delete: if false;
    }
    // What a catering order costs, by order id. Shown only in the manager app: the kitchen screen never
    // loads this collection. (With anonymous sign-in the rules can't tell the two apps apart, so this keeps
    // it off the kitchen tablet rather than locking it.) The app's store adds the doc `id` to every save.
    match /orderAmounts/{id} {
      allow read: if signedIn();
      allow delete: if false; // money records are never deleted from the app
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['amount', 'paid', 'paidAt', 'method', 'takenBy', 'deposits', 'updatedAt', 'id',
                                                 'log', 'itemsAt', 'refundNote'])
        && (!('paid' in request.resource.data) || request.resource.data.paid is bool)
        && (!('paidAt' in request.resource.data) || request.resource.data.paidAt == null || request.resource.data.paidAt is number)
        && (!('method' in request.resource.data) || request.resource.data.method == null
            || request.resource.data.method in ['cash', 'card', 'zelle', 'check'])
        && (!('takenBy' in request.resource.data) || request.resource.data.takenBy == null
            || (request.resource.data.takenBy is string && request.resource.data.takenBy.size() <= 80))
        && (!('deposits' in request.resource.data)
            || (request.resource.data.deposits is list && request.resource.data.deposits.size() <= 20))
        && (!('amount' in request.resource.data) || request.resource.data.amount == null
            || (request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000))
        && (!('itemsAt' in request.resource.data) || request.resource.data.itemsAt == null
            || (request.resource.data.itemsAt is string && request.resource.data.itemsAt.size() <= 20000))
        && (!('refundNote' in request.resource.data) || request.resource.data.refundNote == null
            || (request.resource.data.refundNote is string && request.resource.data.refundNote.size() <= 500))
        && (!('log' in request.resource.data) || (request.resource.data.log is list && request.resource.data.log.size() <= 500))
        && logKept()
        && request.resource.data.updatedAt is number;
    }
    // The money log is add-only: a save must keep every entry already saved, in the same order, at the start.
    function logKept() {
      return resource == null || !('log' in resource.data)
        || ('log' in request.resource.data
            && request.resource.data.log.size() >= resource.data.log.size()
            && request.resource.data.log[0:resource.data.log.size()] == resource.data.log);
    }
    // A catering price estimate (front and manager apps; the kitchen never loads it).
    match /estimates/{id} {
      allow read: if signedIn();
      allow delete: if false; // "Delete" sets deletedAt instead
      allow create, update: if signedIn() && small()
        && request.resource.data.customerName is string && request.resource.data.customerName.size() <= 200
        && request.resource.data.status in ['open', 'ordered']
        && request.resource.data.lines is list && request.resource.data.lines.size() <= 300
        && request.resource.data.total is number
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null || request.resource.data.deletedAt is number)
        && request.resource.data.updatedAt is number;
    }
    match /staffWeeks/{id}  { allow read: if signedIn(); allow create, update: if signedIn() && small(); allow delete: if signedIn(); }
    match /heartbeats/{id}  { allow read: if signedIn(); allow create, update: if signedIn() && small(); allow delete: if signedIn(); }
    match /clocks/{id}      { allow read: if signedIn(); allow create, update: if signedIn() && small(); allow delete: if signedIn(); }
    // Phone alert addresses: devices can save their own, but nobody can read the list (only the server does).
    match /pushTokens/{id} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['token', 'device', 'updatedAt'])
        && request.resource.data.keys().hasAll(['token', 'device', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 400
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 200
        && request.resource.data.updatedAt is number;
    }
    // Toast menu: saved only by the server (reportToastMenu, fed by the kitchen tablet); screens can read it.
    match /toastMenu/{id}   { allow read: if signedIn(); allow write: if false; }
    // How many order photos/messages the AI read each day (the server's daily limit): server only.
    match /usage/{id}       { allow read, write: if false; }
    match /singletons/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && id in ['seeded', 'loop', 'music', 'settings', 'staffConfig', 'cateringPrices'];
    }
    match /pictureData/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'data', 'id'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 950000;
      allow delete: if signedIn();
    }
    // Everything else is closed.
  }
}
